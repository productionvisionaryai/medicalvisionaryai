# ============================================
# Helena AI - Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================
# API Keys (REQUIRED)
# ============================================
GROQ_API_KEY=your_groq_api_key_here
RESEND_API_KEY=your_resend_api_key_here

# ============================================
# AI Configuration
# ============================================
GROQ_MODEL=llama-3.3-70b-versatile
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000

# ============================================
# Contact Information
# ============================================
CONTACT_PHONE=+52-56-16-73-74-67
WHATSAPP_NUMBER=525616737467
CONTACT_EMAIL=aisynths@visionaryai.lat
SUPPORT_EMAIL=support@visionaryai.lat

# ============================================
# Business Details
# ============================================
BUSINESS_NAME=Visionary AI Labs
BUSINESS_ADDRESS=Av. Revolución 1500, CDMX
WEBSITE_URL=https://medical.visionaryai.lat

# ============================================
# Email Configuration
# ============================================
EMAIL_FROM_NAME=Helena AI
EMAIL_FROM_ADDRESS=pavel@medical.visionaryai.lat
EMAIL_TO_DEFAULT=scubapab84@gmail.com

# ============================================
# Feature Flags
# ============================================
ENABLE_WEARABLES=false
ENABLE_LEAD_CAPTURE=true
ENABLE_DATASET_MODE=true

# ============================================
# Rate Limiting
# ============================================
MAX_REQUESTS_PER_MINUTE=10
MAX_CONSULTATIONS_PER_DAY=100

# ============================================
# Environment
# ============================================
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://medical.visionaryai.lat

# ============================================
# CORS Configuration (comma-separated)
# ============================================
# Production origins that are allowed to access the API
ALLOWED_ORIGINS=https://medical.visionaryai.lat,https://www.medical.visionaryai.lat,https://visionaryai.lat
ALLOWED_ORIGINS=http://localhost:3000